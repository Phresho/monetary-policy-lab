.param eps_t=1 z=1.5281 psi=0.0131
.ic I(Whole_sale_loan)=28m
.ic V(hh_bus)=0v
* Shock
* Inductance
* Initial conditions
.ic I(Investment)=28m
.param B0 =14
.param X_ss=21.3m mu_X=1.5 mu_M=1.5 k_S=3 k_N=0.25  P_for=1
.ic I(L_X)=21.3m I(L_M)=21.3m
.param V_bus0=0.1 tau_s=350
.param T_L=440 T_B=840 tau_ret=100 sh_b=0 Bb0=2
* CPI values
.param theta_b=0.95 h_exit={4*(1-theta_b)} Delta_b=1
.param R_A0=0.028 R_B0=0.028 R_ret0=0.0344
.param rho_R=0.865 n_LT=28 s_LT=0.9 phi_B=0.1
.param a_n={(1-pow(rho_R,n_LT))/(n_LT*(1-rho_R))}
.param R_anchor=0.02 B_LT0={0.9*B0}
.param c_LT0={R_anchor+Delta_b*s0}
* Taxes ($/time)
* St. bonds ($/time)
* Lt. bonds ($/time)
* Capital income ($/time)
* Banks
* $/#
KF3 Government_Spending Public_Demand -0.4
* Investment ($/time)
* Export revenue ($/time)
* Import payments ($/time)
.param omega_L={Delta_b} omega_F={Delta_b}
.param BLh0={0.75*B_LT0} BF0=0 gam_h=0.2 tau_h=120
.param prem0={Delta_b*s0} n_lev=2 k_r=1
.param NW0={(q_L0+omega_L*0.25*B_LT0)/Phi_target}
